# ─────────────────────────────────
# AI-Based Policy Retrieval System
# Environment Configuration
# ─────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to GitHub — it's in .gitignore.

# ── MySQL Database ─────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=policy_retrieval_db

# ── JWT Secret (Auth) ──────────────
# Generate a strong random key (e.g., run: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=changeme_to_a_strong_random_secret

# ── Google Gemini API (Cloud Mode) ─
# This is the ONLY supported way to configure the Gemini API key.
# The key is read exclusively by the backend server — it is never sent to or
# entered in the browser UI. Do NOT enter this key anywhere in the frontend.
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
